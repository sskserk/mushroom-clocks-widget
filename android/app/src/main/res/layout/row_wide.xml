<?xml version="1.0" encoding="utf-8"?>
<!-- One city in a wide widget: name and full date; icon, offset and a large time in columns. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/name"
            style="@style/CityName"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/date"
            style="@style/CityDate"
            android:textSize="7sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/phase"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:layout_marginStart="8dp"
        android:importantForAccessibility="no" />

    <!-- Columns: each is as wide as its widest possible text (the invisible
         sample), so icon, offset and time line up in every row at any font size. -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp">

        <TextView
            style="@style/Offset"
            android:gravity="center"
            android:text="+0:00"
            android:textSize="8.5sp"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/offset"
            style="@style/Offset"
            android:layout_width="match_parent"
            android:gravity="center"
            android:textSize="8.5sp" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp">

        <TextView
            style="@style/Time"
            android:text="00:00"
            android:textSize="20sp"
            android:visibility="invisible" />

        <TextClock
            android:id="@+id/time"
            style="@style/Time"
            android:layout_gravity="end"
            android:textSize="20sp" />
    </FrameLayout>

    <TextClock
        android:id="@+id/seconds"
        style="@style/Seconds"
        android:textSize="9sp" />
</LinearLayout>
