<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="CityName">
        <item name="android:shadowColor">#99000000</item>
        <item name="android:shadowRadius">4</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/digits</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:drawablePadding">3dp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="CityDate">
        <item name="android:shadowColor">#99000000</item>
        <item name="android:shadowRadius">4</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/label</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:layout_marginTop">0.5dp</item>
    </style>

    <!-- 24-hour H:MM whatever the phone's setting, like the Mac widget; tabular digits so they do not jiggle. -->
    <style name="Time">
        <item name="android:shadowColor">#99000000</item>
        <item name="android:shadowRadius">4</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:format12Hour">H:mm</item>
        <item name="android:format24Hour">H:mm</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textColor">@color/digits</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:singleLine">true</item>
    </style>

    <!-- Hidden unless chosen in the app: ticking seconds make the launcher redraw every second. -->
    <style name="Seconds" parent="Time">
        <item name="android:format12Hour">ss</item>
        <item name="android:format24Hour">ss</item>
        <item name="android:textColor">@color/label</item>
        <item name="android:layout_marginStart">2dp</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="Offset">
        <item name="android:shadowColor">#99000000</item>
        <item name="android:shadowRadius">4</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:singleLine">true</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:background">@drawable/bg_offset</item>
        <item name="android:paddingHorizontal">5dp</item>
        <item name="android:paddingVertical">1.5dp</item>
    </style>

    <!-- The settings screen: the widget's charcoal and orange. -->
    <style name="AppTheme" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/app_bg</item>
        <item name="android:statusBarColor">@color/app_bg</item>
        <item name="android:navigationBarColor">@color/app_bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColorHint">@color/label</item>
    </style>
</resources>
