<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="CityName">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/digits</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:drawablePadding">3dp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="CityDate">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/label</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:layout_marginTop">1dp</item>
    </style>

    <!-- 24-hour H:MM whatever the phone's setting, like the Mac widget; tabular digits so they do not jiggle. -->
    <style name="Time">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:format12Hour">H:mm</item>
        <item name="android:format24Hour">H:mm</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textColor">@color/digits</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:singleLine">true</item>
    </style>

    <!-- Hidden unless chosen in the app: ticking seconds make the launcher redraw every second. -->
    <style name="Seconds" parent="Time">
        <item name="android:format12Hour">ss</item>
        <item name="android:format24Hour">ss</item>
        <item name="android:textColor">@color/label</item>
        <item name="android:layout_marginStart">2dp</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="Offset">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:singleLine">true</item>
    </style>
</resources>
